PORT=3001
HOST=127.0.0.1
PUBLIC_URL=http://localhost:5173
DATA_DIR=./data
# production: NODE_ENV=production, PUBLIC_URL=https://your-domain.com
# Set behind a trusted reverse proxy only; see README.
TRUST_PROXY=0
# Optional first admin provisioning. Never commit real credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Vercel: wajib gunakan Turso (remote libSQL) dan public Vercel Blob.
# Biarkan kosong/local untuk SQLite dan folder photos pada komputer sendiri.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
STORAGE_PROVIDER=local
BLOB_READ_WRITE_TOKEN=
# Jangan gunakan prefix VITE_ untuk secret. Lihat docs/VERCEL.md.
